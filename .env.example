# Yerel SQLite veritabanı (dosya prisma/dev.db — kurulum: npm run db:setup)
DATABASE_URL="file:./dev.db"

JWT_SECRET="yk-music-center-dev-secret-min-32-chars-change-in-production"

# --- Vercel (Settings → Environment Variables → Production) ---
# Zorunlu: JWT_SECRET (en az 32 karakter, rastgele), DATABASE_URL, NEXT_PUBLIC_APP_URL (https://siteniz.vercel.app)
# SQLite üretimde kalıcı değildir; kalıcı veri için Turso/Postgres önerilir.

# Üretim: Vercel'de (VERCEL_ENV=production) veya ENFORCE_STRONG_JWT_SECRET=1 iken JWT_SECRET en az 32 karakter zorunludur.
# ENFORCE_STRONG_JWT_SECRET=1

# Öğrencilere WhatsApp ile gönderilen giriş linkinin doğru olması için kök URL (örn. https://alanadiniz.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# İleride WhatsApp Business API vb. ile gönderici numarası buradan okunabilir (şimdilik wa.me ile yönetici telefonundan gönderilir).
# WHATSAPP_SENDER_PHONE_E164="+905409478787"

# Öğretmen iş sözleşmesi metin şablonu (UTF-8 .txt, {alanAdı} yer tutucuları) — yalnızca göreli yol. Varsayılan: private/teacher-contract-template.txt
# TEACHER_CONTRACT_TEMPLATE_PATH=private/teacher-contract-template.txt

# İş sözleşmesi .docx çıktısı — Word’deki orijinal belgeye yaklaştırmak için (sunucuyu yeniden başlatın):
# TEACHER_CONTRACT_DOCX_FONT="Times New Roman"
# TEACHER_CONTRACT_DOCX_FONT_SIZE_PT=12
# Tek değer = dört kenar aynı (cm); dört değer = üst,sağ,alt,sol
# TEACHER_CONTRACT_DOCX_MARGINS_CM=2.5
# TEACHER_CONTRACT_DOCX_MARGINS_CM=2.5,2.5,2.5,3
# Sekme aralığı sabit 3 cm'dir (kolon hizası için kodda kilitli).

# İsteğe bağlı — şifre sıfırlama SMS (Twilio). Yoksa üretimde SMS gönderilmez; geliştirmede kod API yanıtında döner.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15551234567"
